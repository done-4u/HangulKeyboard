            android:layout_weight="1" />

        <include
            android:id="@+id/alphabet_key_enter"
            layout="@layout/keyboard_item"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.5" />
    </LinearLayout>

</LinearLayout>
